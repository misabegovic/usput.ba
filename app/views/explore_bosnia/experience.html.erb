<% selected_label = @selected_tiles.any? ? @selected_tiles.map { |key| t("explore_bosnia.tiles.#{key}") }.join(", ") : t("explore_bosnia.filters.all_categories") %>
<% content_for :title, "#{t('explore_bosnia.title')} — #{selected_label}" %>

<% content_for :head do %>
  <%= stylesheet_link_tag "leaflet" %>
<% end %>

<%# Navigation %>
<%= render "new_design/header" %>

<%# The deck owns everything below the fixed header: no page scroll, no
    scrollbar, exactly one card in view. %>
<%# explore-geo only mounts while the position is missing: it asks once, then
    reloads the deck with the coordinates. %>
<div class="fixed inset-x-0 bottom-0 top-[calc(5rem+env(safe-area-inset-top))] flex flex-col overflow-hidden pb-[env(safe-area-inset-bottom)]"
     data-controller="moment-lightbox<%= " explore-geo" if @needs_location %>"
     <% if @needs_location %>
       data-explore-geo-failed-body-value="<%= t("explore_bosnia.needs_location.body") %>"
       data-explore-geo-retry-label-value="<%= t("explore_bosnia.needs_location.retry") %>"
       data-explore-geo-fallback-lat-value="<%= ExploreBosniaController::DEFAULT_ORIGIN.first %>"
       data-explore-geo-fallback-lng-value="<%= ExploreBosniaController::DEFAULT_ORIGIN.last %>"
     <% end %>>
  <%# Filters and deck swap together, in place: picking one filter must not cost a
      page load, or the next pill is dead until it lands. display:contents keeps
      the frame out of the flex column it wraps. %>
  <%= turbo_frame_tag "explore_deck", data: { turbo_action: "advance" }, class: "contents" do %>
  <%# The deck dealt from the country's default because the browser never
      answered. Saying so beats quoting distances from a city the traveller may
      not be in; the link drops the coordinates so the ask starts over. %>
  <% if @approximate_origin %>
    <div class="mx-4 mt-2 flex items-center justify-between gap-3 rounded-xl bg-amber-50 px-4 py-2 text-sm text-amber-900 dark:bg-amber-900/30 dark:text-amber-200">
      <span><%= t("explore_bosnia.approximate_origin.body") %></span>
      <%= link_to t("explore_bosnia.approximate_origin.retry"),
            explore_bosnia_experience_path(@category, **filter_params),
            class: "shrink-0 font-semibold underline" %>
    </div>
  <% end %>
  <%# Desktop keeps the filters open beside the deck — the convention for this
      many facets. Narrow screens get the same panel behind a toggle. %>
  <div class="px-4 py-2 lg:hidden" data-controller="deck-filters">
    <div class="flex items-center justify-between gap-2">
      <span class="truncate text-sm font-semibold text-gray-900 dark:text-white"><%= selected_label %></span>
      <button type="button" data-action="deck-filters#toggle"
              class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700">
        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h18M6 12h12M10 20h4" /></svg>
        <%= t("explore_bosnia.filters.title") %>
        <% if chosen_filter_count.positive? %>
          <span class="rounded-full bg-yellow-400 px-1.5 text-xs text-gray-900"><%= chosen_filter_count %></span>
        <% end %>
      </button>
    </div>

    <div class="hidden mt-3 rounded-2xl bg-white p-4 shadow-sm dark:bg-gray-800" data-deck-filters-target="panel">
      <%= render "explore_bosnia/filters",
            category: @category, tile_keys: @tile_keys, selected_tiles: @selected_tiles,
            lat: @lat, lng: @lng, season: @season, budget: @budget,
            min_rating: @min_rating %>
    </div>
  </div>

    <div id="moment-flash" class="absolute inset-x-0 top-12 z-30 px-4"></div>

    <div class="mx-auto flex min-h-0 w-full max-w-7xl flex-1 gap-6 lg:px-8">
      <%# A persistent rail, not a toggle: filters stay in view beside the deck. %>
      <aside class="hidden w-64 shrink-0 self-center max-h-[calc(100dvh-11rem)] overflow-y-auto rounded-2xl bg-white p-4 shadow-sm lg:block dark:bg-gray-800"
             data-controller="deck-filters">
        <%= render "explore_bosnia/filters",
              category: @category, tile_keys: @tile_keys, selected_tiles: @selected_tiles,
              lat: @lat, lng: @lng, season: @season, budget: @budget,
              min_rating: @min_rating %>
      </aside>

      <%# The hint belongs to the deck column, not the viewport: with the filter
          rail beside it, screen-centre sits left of the card. %>
      <div class="relative flex min-h-0 flex-1 flex-col">
        <div class="flex-1 snap-y snap-mandatory overflow-y-auto overscroll-y-contain scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
             data-controller="plan-deck" data-plan-deck-browse-value="true">
          <%# Inside the deck so the action resolves against it, and sticky
              rather than a snap slot so it never becomes a card you scroll past.
              The traveller asks for a new position; nothing tracks them between
              asks. %>
          <div class="sticky top-0 z-30 flex justify-end px-4 pt-2">
            <%# Hidden until the deck is provably out of date. It says why the
                button is worth pressing, which the button alone cannot. %>
            <span data-plan-deck-target="movedPrompt"
                  class="hidden mr-2 self-center rounded-full bg-amber-100 px-3 py-1.5 text-xs font-medium text-amber-900 shadow dark:bg-amber-900/50 dark:text-amber-100">
              <%= t("explore_bosnia.moved_prompt") %>
            </span>
            <button type="button" data-action="plan-deck#updateLocation"
                    class="inline-flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1.5 text-xs font-semibold text-gray-700 shadow backdrop-blur transition-colors hover:bg-white disabled:opacity-50 dark:bg-gray-900/80 dark:text-gray-200 dark:hover:bg-gray-900">
              <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <%= t("explore_bosnia.update_location") %>
            </button>
          </div>

          <% if @needs_location %>
            <%# Nothing can be dealt without a position; the prompt is a deck slot
                like any other, and explore-geo reloads once the fix lands. %>
            <%= render "explore_bosnia/message_card", message: t("explore_bosnia.needs_location.title") %>
          <% else %>
            <%= render "explore_bosnia/deck_cards", plan: @plan, locations: @locations %>

            <% if @locations.empty? %>
              <%= render "explore_bosnia/message_card",
                    message: @all_visited ? t("explore_bosnia.deck_all_visited") : t("explore_bosnia.deck_empty") %>
            <% end %>

            <%= render "explore_bosnia/deck_tail",
                  next_url: @next_cursor ? explore_bosnia_experience_path(@category, **next_page_params) : nil,
                  end_message: @locations.any? ? t("explore_bosnia.deck_end") : nil %>
          <% end %>
        </div>

        <%= render "plans/deck_hints", scroll_hint: t("explore_bosnia.deck_hint") %>
      </div>
    </div>
  <% end %>

  <div data-moment-lightbox-target="overlay"
       data-action="click->moment-lightbox#closeOnBackground"
       class="hidden fixed inset-0 z-[70] flex items-center justify-center bg-black/80 p-4">
    <button type="button" data-action="moment-lightbox#close"
            class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20"
            aria-label="<%= t('common.close') %>">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <img data-moment-lightbox-target="image" src="" alt="" class="max-h-[85vh] max-w-full rounded-lg object-contain shadow-2xl">
  </div>
</div>
