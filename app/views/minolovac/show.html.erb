<% content_for :title, "#{t('minolovac.title')} — Usput.ba" %>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 transition-colors duration-300">
  <nav class="bg-white dark:bg-gray-800 shadow sticky top-0 z-50 transition-colors duration-300">
    <div class="max-w-2xl mx-auto px-4 h-14 flex items-center justify-between">
      <a href="/" class="flex items-center space-x-2">
        <img src="/usput-logo.png" alt="Usput" class="h-8 w-auto">
        <span class="text-xl font-bold bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent">Usput.ba</span>
      </a>
      <%= link_to t("minolovac.back_home"), root_path, class: "text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors" %>
    </div>
  </nav>

  <main class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t("minolovac.title") %></h1>
    <p class="mt-1 text-gray-600 dark:text-gray-400"><%= t("minolovac.subtitle") %></p>

    <div class="mt-4 rounded-xl border-2 border-amber-400 dark:border-amber-500 bg-amber-50 dark:bg-amber-900/30 p-4">
      <p class="font-bold text-amber-900 dark:text-amber-200"><%= t("minolovac.disclaimer_title") %></p>
      <p class="mt-1 text-sm text-amber-900 dark:text-amber-100"><%= t("minolovac.disclaimer") %></p>
      <p class="mt-2 text-xs text-amber-800 dark:text-amber-300"><%= t("minolovac.awareness") %></p>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-2">
      <span class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= t("minolovac.region") %>:</span>
      <% MinolovacController::REGIONS.each do |slug, region| %>
        <%= link_to region[:name], minolovac_path(region: slug, level: @level),
              class: "px-3 py-1 rounded-full text-sm font-medium transition-colors #{slug == @region_slug ? 'bg-emerald-600 text-white' : 'bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-emerald-50 dark:hover:bg-gray-700 border border-gray-200 dark:border-gray-700'}" %>
      <% end %>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= t("minolovac.difficulty") %>:</span>
      <% MinolovacController::DIFFICULTIES.each_key do |level| %>
        <%= link_to t("minolovac.level_#{level}"), minolovac_path(region: @region_slug, level: level),
              class: "px-3 py-1 rounded-full text-sm font-medium transition-colors #{level == @level ? 'bg-emerald-600 text-white' : 'bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-emerald-50 dark:hover:bg-gray-700 border border-gray-200 dark:border-gray-700'}" %>
      <% end %>
    </div>

    <div class="mt-6"
         data-controller="minolovac"
         data-minolovac-rows-value="<%= @difficulty[:rows] %>"
         data-minolovac-cols-value="<%= @difficulty[:cols] %>"
         data-minolovac-mines-value="<%= @difficulty[:mines] %>"
         data-minolovac-labels-value="<%= { win: t('minolovac.win'), lose: t('minolovac.lose') }.to_json %>">

      <div class="flex items-center justify-between rounded-t-xl bg-white dark:bg-gray-800 border border-b-0 border-gray-200 dark:border-gray-700 px-4 py-2">
        <div class="text-sm text-gray-700 dark:text-gray-300">
          &#x1F6A9; <span data-minolovac-target="mines" class="font-bold tabular-nums"></span>
        </div>
        <div data-minolovac-target="status" class="text-sm font-bold text-emerald-700 dark:text-emerald-400" aria-live="polite"></div>
        <div class="flex items-center gap-3">
          <span class="text-sm text-gray-700 dark:text-gray-300">&#x23F1; <span data-minolovac-target="timer" class="font-bold tabular-nums">0</span></span>
          <button type="button" data-action="minolovac#newGame"
                  class="px-3 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium transition-colors">
            <%= t("minolovac.restart") %>
          </button>
        </div>
      </div>

      <div class="relative rounded-b-xl overflow-hidden border border-gray-200 dark:border-gray-700 bg-gradient-to-br from-emerald-100 to-teal-200 dark:from-gray-800 dark:to-gray-700">
        <img src="<%= minolovac_map_path(region: @region_slug) %>"
             alt="<%= @region[:name] %>"
             class="absolute inset-0 w-full h-full object-cover"
             data-minolovac-target="map"
             data-action="error->minolovac#hideMap">
        <div class="relative z-10 grid gap-px p-1" data-minolovac-target="board"></div>
      </div>

      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400"><%= t("minolovac.hint") %></p>
    </div>
  </main>
</div>
