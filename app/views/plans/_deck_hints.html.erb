<%# Locals: scroll_hint. In the card chrome's colours, and click-through, so the
    deck underneath stays scrollable. %>
<p data-deck-hint
   class="pointer-events-none absolute inset-x-0 bottom-3 z-30 mx-auto w-fit max-w-[92%] rounded-full bg-black/45 px-4 py-1.5 text-center text-xs font-semibold text-white backdrop-blur-sm">
  <%= scroll_hint %>
</p>
