<%# Locals: plan, location, moments, public_moments, context.
    On a place's own page the moments read like its photos: the same horizontal
    snap slider at the same tile size, directly beneath them. The walk and
    explore keep a compact grid, where a strip would hide everything past the
    third. Replaced wholesale by moments/update, so uploads land without a reload. %>
<% narrow = context.in?(%w[explore walk])
   tile = narrow ? { wrapper: "text-center", image: "aspect-square w-full", size: "thumb", fill: [ 200, 200 ], inline_controls: true }
                 : { wrapper: "flex-shrink-0 snap-start w-48 sm:w-56", image: "h-36 sm:h-40 w-full", size: "square", fill: [ 400, 300 ] }
   layout = narrow ? "mt-3 grid grid-cols-3 gap-3 pb-2"
                   : "mt-3 flex gap-3 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-thin scrollbar-thumb-gray-300 dark:scrollbar-thumb-gray-600 scrollbar-track-transparent"
   total = moments.total_count + public_moments.total_count
   shown = moments.size + public_moments.size %>

<div data-controller="load-more photo-gallery"
     data-photo-gallery-index-value="0"
     data-photo-gallery-total-value="<%= total %>"
     data-action="photo-gallery:edgeReached->load-more#loadFromEdge"
     data-load-more-url-value="<%= location_moments_path(location, context: context) %>"
     data-load-more-resource-type-value="moments"
     data-load-more-page-value="1"
     data-load-more-total-count-value="<%= total %>"
     data-load-more-per-page-value="<%= Moment::PAGE_SIZE * 2 %>">
  <div class="flex items-center justify-between gap-2 <%= "mb-4" unless narrow %>">
    <h3 class="flex items-center font-semibold text-gray-900 dark:text-white <%= narrow ? "text-base" : "text-lg" %>">
      <% unless narrow %>
        <svg class="mr-2 size-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      <% end %>
      <%= t("plans.start.shared_moments") %>
      <span class="ml-2 text-sm font-normal text-gray-500 dark:text-gray-400">
        (<span data-load-more-target="count"><%= shown %></span>/<%= total %>)
      </span>
    </h3>
    <div class="flex items-center gap-2">
      <% if total.positive? %>
        <button type="button" data-action="click->photo-gallery#openLightbox" data-index="0"
                class="flex items-center text-sm font-medium text-emerald-600 hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-300">
          <%= t("locations.show.view_all") %>
          <svg class="ml-1 size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
          </svg>
        </button>
      <% end %>
    </div>
  </div>

  <div class="<%= layout %>">
    <div class="<%= tile[:wrapper] %>" data-action="submit->photo-gallery#closeLightbox">
      <%= render "plans/moment_instant_form", plan: plan, location: location,
            context: context, compact: true, tile: tile %>
    </div>

    <div class="contents" data-load-more-target="container">
      <%= render "plans/moment_gallery_items", moments: moments,
            public_moments: public_moments, context: context, tile: tile %>
    </div>
  </div>

  <% if total > shown %>
    <div class="mt-8 text-center">
      <button type="button"
              data-load-more-target="button"
              data-action="click->load-more#loadMore"
              class="inline-flex items-center rounded-full bg-gray-100 px-6 py-3 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700">
        <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
        <%= t("explore.load_more") %>
      </button>
      <div class="mt-8 hidden text-center" data-load-more-target="loading">
        <svg class="mx-auto h-6 w-6 animate-spin text-blue-600 dark:text-yellow-500" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
    </div>
  <% end %>

  <% if total.zero? %>
    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= t("plans.start.story_none") %></p>
    <% if logged_in? %>
      <p class="mt-1 text-xs text-gray-400 dark:text-gray-500"><%= t("plans.start.story_upload_note") %></p>
    <% end %>
  <% end %>

  <%= render "shared/photo_lightbox", count: total, moment_caption: "location" if total.positive? %>
</div>
