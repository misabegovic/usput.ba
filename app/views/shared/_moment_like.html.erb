<%# Locals: moment, scope. scope names the gallery so two do not share a dom id,
    and rides the url as the replace target. The controller rewrites it per swipe. %>
<% liked = moment && liked_moment?(moment) %>
<div id="<%= scope %>_moment_like" class="flex items-center gap-1.5">
  <a href="<%= moment ? moment_like_path(moment, context: scope) : "#" %>"
     data-turbo-method="<%= liked ? "delete" : "post" %>"
     data-photo-gallery-target="captionLike"
     data-liked="<%= liked %>"
     class="flex size-10 items-center justify-center rounded-full transition-colors
            <%= liked ? "text-red-500 hover:bg-white/10" : "text-white/80 hover:bg-white/10 hover:text-red-500" %>"
     aria-label="<%= liked ? t("explore.moment_like_undo") : t("explore.moment_like_add") %>"
     aria-pressed="<%= liked %>">
    <svg class="size-5" fill="<%= liked ? "currentColor" : "none" %>" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
    </svg>
  </a>
  <span data-photo-gallery-target="captionLikeCount" class="min-w-4 text-sm font-semibold text-white">
    <%= moment&.likes_count.to_i.positive? ? moment.likes_count : "" %>
  </span>
</div>
