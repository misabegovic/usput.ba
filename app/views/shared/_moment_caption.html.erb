<%# Locals: scope. Moment-only chrome; place galleries render without it.
    Filled from the active tile, so swiping costs no request. %>
<div class="pointer-events-none absolute inset-x-0 top-0 z-10 flex flex-wrap items-center gap-x-3 gap-y-1 bg-gradient-to-b from-gray-950/80 to-transparent p-4 pr-16 sm:pr-20">
  <span class="text-xs font-semibold uppercase tracking-wider text-yellow-500">
    <%= t("explore.sections.moments") %>
  </span>
  <span class="pointer-events-auto inline-flex items-center gap-2">
    <span class="flex size-7 items-center justify-center rounded-full bg-yellow-500/20 text-yellow-500">
      <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
      </svg>
    </span>
    <span data-photo-gallery-target="captionAuthor" class="text-sm font-semibold text-white"></span>
  </span>
  <%# In the fixed top bar, not the bottom stack: the note is two lines or none,
      so a date under it lands somewhere new on every swipe. %>
  <span data-photo-gallery-target="captionUploaded" class="text-xs text-white/60"></span>
</div>

<div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-gray-950/90 via-gray-950/70 to-transparent p-4 pb-12 pt-16">
  <div class="pointer-events-auto mx-auto flex max-w-2xl flex-col gap-2">
    <a data-photo-gallery-target="captionPlace" href="#"
       class="group inline-flex items-center gap-2 self-start text-base font-semibold text-white">
      <svg class="size-5 shrink-0 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      <span data-photo-gallery-target="captionPlaceName" class="group-hover:text-yellow-500"></span>
      <svg class="size-4 shrink-0 text-white/50 transition-transform group-hover:translate-x-0.5 group-hover:text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>

    <p data-photo-gallery-target="captionNote" class="line-clamp-2 text-sm text-white/80"></p>

    <%= render "shared/moment_status", scope: scope, message: nil %>

    <%= form_with url: "#", method: :patch, class: "hidden",
                  data: { photo_gallery_target: "captionNoteForm" } do %>
      <input type="hidden" name="context" value="<%= scope %>">
      <input type="hidden" name="scope" value="<%= scope %>">
      <div class="flex items-end gap-2">
        <textarea name="moment[note]" rows="2" maxlength="1000"
                  data-photo-gallery-target="captionNoteField"
                  placeholder="<%= t("plans.moments.note_label") %>"
                  class="min-w-0 flex-1 rounded-xl border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-white/50 focus:border-yellow-500 focus:outline-none"></textarea>
        <button type="submit"
                class="shrink-0 rounded-full bg-yellow-500 px-4 py-2 text-xs font-semibold text-gray-900 hover:bg-yellow-400">
          <%= t("plans.moments.note_save") %>
        </button>
      </div>
    <% end %>

    <div class="mt-1 flex flex-wrap items-center gap-2">
      <%= render "shared/moment_like", moment: nil, scope: scope %>

      <button type="button" data-photo-gallery-target="captionShare"
              data-action="click->photo-gallery#shareMoment"
              class="hidden size-10 items-center justify-center rounded-full text-white/80 transition-colors hover:bg-white/10 hover:text-yellow-500"
              data-copied-label="<%= t("explore.moment_share_copied") %>"
              data-failed-label="<%= t("explore.moment_share_failed") %>"
              aria-label="<%= t("explore.moment_share") %>">
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684zm0-12a3 3 0 105.368-2.684 3 3 0 00-5.368 2.684z"></path>
        </svg>
      </button>

      <a data-photo-gallery-target="captionDownload" href="#" download
         class="flex size-10 items-center justify-center rounded-full text-white/80 transition-colors hover:bg-white/10 hover:text-yellow-500"
         aria-label="<%= t("explore.moment_download") %>">
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
      </a>

      <%= form_with url: "#", method: :patch, class: "hidden",
                    data: { photo_gallery_target: "captionVisibility" } do %>
        <input type="hidden" name="context" value="<%= scope %>">
        <button type="submit"
                data-photo-gallery-target="captionVisibilityButton"
                class="rounded-full bg-blue-600 px-4 py-2.5 text-xs font-semibold text-white transition-colors hover:bg-blue-700"></button>
      <% end %>

      <%# Closes on success: the moment being read is the one being deleted, so
          leaving the viewer open leaves it showing a photo that no longer exists
          until something else happens to move it. %>
      <%= form_with url: "#", method: :delete, class: "ml-auto hidden",
                    data: { photo_gallery_target: "captionDelete",
                            action: "turbo:submit-end->photo-gallery#closeOnDelete",
                            turbo_confirm: t("plans.start.story_delete_confirm") } do %>
        <input type="hidden" name="context" value="<%= scope %>">
        <button type="submit"
                class="flex size-10 items-center justify-center rounded-full text-red-400 transition-colors hover:bg-red-500/20"
                aria-label="<%= t("plans.start.story_delete") %>">
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        </button>
      <% end %>
    </div>
  </div>
</div>
