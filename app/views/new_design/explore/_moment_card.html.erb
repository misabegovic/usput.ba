<%# Moment Card for Explore — a traveller's shared photo of a place.
    Optional: expandable — the photo opens full screen and the place line is the
    link, matching the owner's card. Without it the whole card links to the
    place (the home strip, which has no gallery to open into). %>
<% expandable = local_assigns.fetch(:expandable, false) %>

<% media = capture do %>
  <div class="aspect-[4/3] overflow-hidden relative">
    <% if moment.displayable? %>
      <%= image_tag moment.photo.variant(resize_to_fill: [ 400, 300 ]),
          alt: moment.location.name,
          loading: "lazy",
          class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" %>
    <% else %>
      <div class="w-full h-full bg-gradient-to-br from-emerald-100 to-emerald-200 dark:from-emerald-900/30 dark:to-emerald-800/30"></div>
    <% end %>
    <div class="absolute top-2 left-2">
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100/90 text-emerald-800 dark:bg-emerald-900/80 dark:text-emerald-200 backdrop-blur-sm">
        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
        </svg>
        <%= t("explore.types.moment") %>
      </span>
    </div>
  </div>
<% end %>

<% if expandable %>
  <%# Column, not a block: a moment without a note leaves the grid row's height
      unfilled and the heart rides up out of line with its neighbours. %>
  <%= turbo_frame_tag dom_id(moment, :public), class: "group flex h-full flex-col bg-white dark:bg-gray-800 rounded-2xl shadow-sm overflow-hidden" do %>
    <button type="button"
            data-action="click->photo-gallery#openLightbox"
            data-photo-gallery-target="thumbnail"
            data-photo-gallery-full-url="<%= url_for(moment.photo.variant(resize_to_limit: [ 1080, 1080 ])) if moment.displayable? %>"
            <%= tag.attributes(moment_caption_data(moment, scope: "moments", download_url: rails_blob_path(moment.photo, disposition: "attachment"))) %>
            class="block w-full cursor-zoom-in">
      <%= media %>
    </button>

    <%= render "new_design/explore/moment_card_body", moment: moment, linked: true,
          byline: t("explore.moment_by", user: moment.user.username) %>

    <div class="mt-auto flex items-center gap-2 px-4 pb-4">
      <%= render "new_design/explore/moment_card_likes", moment: moment, scope: "moments" %>
      <span class="ml-auto text-xs text-gray-400 dark:text-gray-500"><%= moment_uploaded_at(moment) %></span>
    </div>
  <% end %>
<% else %>
  <%= link_to location_path(moment.location), class: "group block bg-white dark:bg-gray-800 rounded-2xl shadow-sm hover:shadow-lg transition-all overflow-hidden", data: { turbo_frame: "_top" } do %>
    <%= media %>
    <%= render "new_design/explore/moment_card_body", moment: moment,
          byline: "#{t("explore.moment_by", user: moment.user.username)} · #{moment_uploaded_at(moment)}" %>
  <% end %>
<% end %>
