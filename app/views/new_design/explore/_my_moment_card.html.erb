<%# Locals: moment, index. The photo streams through our own action, never a
    signed blob url, which would serve a private moment without a session. %>
<%= turbo_frame_tag dom_id(moment), class: "group block bg-white dark:bg-gray-800 rounded-2xl shadow-sm transition-all hover:shadow-lg overflow-hidden" do %>
  <button type="button"
          data-action="click->photo-gallery#openLightbox"
          data-index="<%= index %>"
          data-photo-gallery-target="thumbnail"
          data-photo-gallery-full-url="<%= photo_plan_moment_path(moment.plan, moment, size: "story") %>"
          class="relative block w-full cursor-zoom-in aspect-[4/3] overflow-hidden">
    <%= image_tag photo_plan_moment_path(moment.plan, moment, size: "square"),
          alt: moment.location.name, loading: "lazy",
          class: "w-full h-full object-cover" %>

    <span class="absolute top-2 left-2 inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium backdrop-blur-sm
                 <%= moment.visibility_private_moment? ? "bg-gray-900/80 text-yellow-200" : (moment.approved? ? "bg-emerald-900/80 text-emerald-100" : "bg-amber-900/80 text-amber-100") %>">
      <%= moment.visibility_private_moment? ? t("plans.start.story_private") : (moment.approved? ? t("plans.start.story_public") : t("plans.start.story_pending")) %>
    </span>
  </button>

  <%= render "new_design/explore/moment_card_body", moment: moment, linked: true %>

  <div class="flex flex-wrap items-center gap-2 px-4 pb-4">
    <% if moment.visibility_private_moment? %>
      <%= button_to t("plans.start.story_publish"), publish_plan_moment_path(moment.plan, moment),
            method: :patch,
            params: { context: "browse", index: index },
            class: "rounded-full bg-gray-900 px-3 py-1 text-xs font-semibold text-white dark:bg-white dark:text-gray-900" %>
    <% else %>
      <%= button_to t("plans.moments.make_private"), unpublish_plan_moment_path(moment.plan, moment),
            method: :patch,
            params: { context: "browse", index: index },
            class: "rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700 dark:bg-gray-700 dark:text-gray-200" %>
    <% end %>

    <%= button_to t("plans.start.story_delete"), plan_moment_path(moment.plan, moment),
          method: :delete,
          params: { context: "browse" },
          form: { data: { turbo_confirm: t("plans.start.story_delete_confirm") } },
          class: "rounded-full bg-red-600 px-3 py-1 text-xs font-semibold text-white" %>
  </div>
<% end %>
