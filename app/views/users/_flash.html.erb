<% if notice %>
  <div class="mb-6 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-lg p-4">
    <p class="text-sm text-emerald-700 dark:text-emerald-400"><%= notice %></p>
  </div>
<% end %>
<% if alert %>
  <div class="mb-6 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
    <p class="text-sm text-red-700 dark:text-red-400"><%= alert %></p>
  </div>
<% end %>
